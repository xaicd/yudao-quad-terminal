{
  "project": "yudao-quad-terminal",
  "version": "1.2.0",
  "rollbackWindowMinutes": 5,
  "steps": [
    { "order": 1, "action": "停止异常应用实例并切回上一稳定制品", "command": "./deploy/service.sh stop && ./deploy/service.sh start" },
    { "order": 2, "action": "核验服务进程与端口状态", "command": "./deploy/service.sh status" },
    { "order": 3, "action": "线上健康拨测验证", "command": "./deploy/service.sh health" }
  ]
}
