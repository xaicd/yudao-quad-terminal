# deploy/caddy/yudao-quad-terminal.caddy
# 项目: yudao-quad-terminal
# B 端中台: /yudao-quad-terminal/admin/ 或 /admin/ (端口 48121)
# C 端门户: /yudao-quad-terminal/2c/ 或 /2c/ (端口 48122)
# 管理契约: /yudao-quad-terminal/admin-api/* 与 /admin-api/* (端口 48080)
# 用户契约: /yudao-quad-terminal/app-api/* 与 /app-api/* (端口 48080)
# 开放契约: /yudao-quad-terminal/open-api/* 与 /open-api/* (端口 48080)

# ==============================================================================
# 1. 接口契约路由 (精确反代，严格防 SPA Fallback 假阳性)
# ==============================================================================

# 1.1 管理后台接口 (/admin-api/*)
handle /yudao-quad-terminal/admin-api/* {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
handle /admin-api/* {
	reverse_proxy 127.0.0.1:48080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# 1.2 用户端/小程序接口 (/app-api/*)
handle /yudao-quad-terminal/app-api/* {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
handle /app-api/* {
	reverse_proxy 127.0.0.1:48080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# 1.3 开放平台/第三方接口 (/open-api/*)
handle /yudao-quad-terminal/open-api/* {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
handle /open-api/* {
	reverse_proxy 127.0.0.1:48080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# 1.4 内部微服务 RPC 调用接口 (/rpc-api/*)
handle /yudao-quad-terminal/rpc-api/* {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080
}
handle /rpc-api/* {
	reverse_proxy 127.0.0.1:48080
}

# 1.5 Knife4j / OpenAPI / Swagger 接口文档与静态依赖
handle /yudao-quad-terminal/doc.html {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080
}
handle /doc.html {
	reverse_proxy 127.0.0.1:48080
}
handle /yudao-quad-terminal/v3/api-docs/* {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080
}
handle /v3/api-docs/* {
	reverse_proxy 127.0.0.1:48080
}
handle /yudao-quad-terminal/swagger-ui/* {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080
}
handle /swagger-ui/* {
	reverse_proxy 127.0.0.1:48080
}
handle /yudao-quad-terminal/webjars/* {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080
}
handle /webjars/* {
	reverse_proxy 127.0.0.1:48080
}

# 1.6 WebSocket 长连接通道 (/infra/ws/*)
handle /yudao-quad-terminal/infra/ws/* {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080 {
		header_up Host {host}
		header_up Upgrade {>Upgrade}
		header_up Connection {>Connection}
	}
}
handle /infra/ws/* {
	reverse_proxy 127.0.0.1:48080 {
		header_up Host {host}
		header_up Upgrade {>Upgrade}
		header_up Connection {>Connection}
	}
}

# 1.7 SSE 流式输出通道与 MCP 协议端点 (/sse, /mcp/*)
handle /yudao-quad-terminal/sse {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080 {
		header_down -X-Accel-Buffering
	}
}
handle /sse {
	reverse_proxy 127.0.0.1:48080 {
		header_down -X-Accel-Buffering
	}
}
handle /yudao-quad-terminal/mcp/* {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080
}
handle /mcp/* {
	reverse_proxy 127.0.0.1:48080
}

# 1.8 报表与运维探针 (/jmreport/*, /actuator/*)
handle /yudao-quad-terminal/actuator/* {
	uri strip_prefix /yudao-quad-terminal
	reverse_proxy 127.0.0.1:48080
}
handle /actuator/* {
	reverse_proxy 127.0.0.1:48080
}

# ==============================================================================
# 2. C 端前台门户 (/yudao-quad-terminal/2c/ 与 /2c/) -> 端口 48122
# ==============================================================================
redir /yudao-quad-terminal/2c /yudao-quad-terminal/2c/ 308
handle /yudao-quad-terminal/2c/* {
	uri strip_prefix /yudao-quad-terminal/2c
	reverse_proxy 127.0.0.1:48122 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

redir /2c /2c/ 308
handle /2c/* {
	uri strip_prefix /2c
	reverse_proxy 127.0.0.1:48122 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# ==============================================================================
# 3. B 端管理中台 (/yudao-quad-terminal/admin/ 与 /admin/) -> 端口 48121
# ==============================================================================
redir /yudao-quad-terminal/admin /yudao-quad-terminal/admin/ 308
handle /yudao-quad-terminal/admin/* {
	uri strip_prefix /yudao-quad-terminal/admin
	reverse_proxy 127.0.0.1:48121 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

redir /admin /admin/ 308
handle /admin/* {
	uri strip_prefix /admin
	reverse_proxy 127.0.0.1:48121 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# ==============================================================================
# 4. 项目根重定向 (访问 /yudao-quad-terminal 默认分流至 B 端中台)
# ==============================================================================
redir /yudao-quad-terminal /yudao-quad-terminal/admin/ 308
redir /yudao-quad-terminal/ /yudao-quad-terminal/admin/ 308
