# 本地开发环境：本地启动所有项目（前端、后端、APP）时使用，统一经由网关与 BASE_PATH 通信
NODE_ENV=development

VITE_DEV=true

# 请求路径（统一走网关端口，配合 VITE_API_URL={{BASE_PATH}}/admin-api 同源转发）
VITE_BASE_URL='http://127.0.0.1:{{GATEWAY_PORT}}'

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持 S3 服务
VITE_UPLOAD_TYPE=server

# 接口地址（挂载统一 BASE_PATH）
VITE_API_URL={{BASE_PATH}}/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=false

# 是否开启压缩，可以设置为 none, gzip, brotli, gzip,brotli
VITE_COMPRESS=none

# 打包路径（对齐四端规范 /<slug>/admin/）
VITE_BASE_PATH={{BASE_PATH}}/admin/

# 商城H5会员端域名（对齐四端规范 /<slug>/2c/）
VITE_MALL_H5_DOMAIN='http://127.0.0.1:{{GATEWAY_PORT}}{{BASE_PATH}}/2c/'

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=false

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'
