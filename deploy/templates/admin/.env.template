# 标题
VITE_APP_TITLE={{PLATFORM_TITLE}}

# 项目本地运行端口号
VITE_PORT={{ADMIN_PORT}}

# open 运行 pnpm dev 时自动打开浏览器
VITE_OPEN=true

# 租户开关
VITE_APP_TENANT_ENABLE=true

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=true

# 文档地址的开关（派生工程默认关闭上游推广提示）
VITE_APP_DOCALERT_ENABLE=false

# 统一 BasePath 前缀与管理端挂载路径
VITE_BASE_PATH={{BASE_PATH}}/admin/
VITE_API_PREFIX={{BASE_PATH}}/admin-api
VITE_APP_API_PREFIX={{BASE_PATH}}/app-api
VITE_OPEN_API_PREFIX={{BASE_PATH}}/open-api
VITE_OPENAPI_DOCS_URL={{BASE_PATH}}/v3/api-docs

# 统计标识（按需注入，严禁硬编码第三方标识）
VITE_APP_BAIDU_CODE = ''

# 默认租户（严禁预填弱默认账号与口令；引导凭据统一由 CSPRNG 生成至 .commandcode/lite/credentials.env）
VITE_APP_DEFAULT_LOGIN_TENANT = {{SHORT_NAME}}
VITE_APP_DEFAULT_LOGIN_USERNAME = ''
VITE_APP_DEFAULT_LOGIN_PASSWORD = ''

# API 加解密
VITE_APP_API_ENCRYPT_ENABLE = true
VITE_APP_API_ENCRYPT_HEADER = X-Api-Encrypt
VITE_APP_API_ENCRYPT_ALGORITHM = AES
VITE_APP_API_ENCRYPT_REQUEST_KEY = 52549111389893486934626385991395
VITE_APP_API_ENCRYPT_RESPONSE_KEY = 96103715984234343991809655248883

# 地图 SDK Key（按需通过环境变量注入，严禁硬编码密钥）
VITE_BAIDU_MAP_KEY = ''
