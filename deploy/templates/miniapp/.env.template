# 商城版本
SHOPRO_VERSION=v2.4.1

# 统一 BasePath 前缀与 C 端 H5 路径
VITE_BASE_PATH={{BASE_PATH}}/2c/
SHOPRO_BASE_PATH={{BASE_PATH}}/2c/

# 后端接口 - 正式/体验/开发环境统一走网关
SHOPRO_BASE_URL=http://127.0.0.1:{{GATEWAY_PORT}}
SHOPRO_TRIAL_BASE_URL=http://127.0.0.1:{{GATEWAY_PORT}}
SHOPRO_DEV_BASE_URL=http://127.0.0.1:{{GATEWAY_PORT}}

# 后端接口前缀（挂载统一 BASE_PATH）
SHOPRO_API_PATH={{BASE_PATH}}/app-api
SHOPRO_WEBSOCKET_PATH={{BASE_PATH}}/infra/ws

# 开发环境运行端口
SHOPRO_DEV_PORT=48122

# 客户端静态资源与 H5 访问地址
SHOPRO_STATIC_URL=http://127.0.0.1:{{GATEWAY_PORT}}{{BASE_PATH}}/2c
SHOPRO_H5_URL=http://127.0.0.1:{{GATEWAY_PORT}}{{BASE_PATH}}/2c/

# 默认租户与标题
SHOPRO_TENANT_ID=1
VITE_APP_TITLE={{PLATFORM_TITLE}}
SHOPRO_MPLIVE_ON=0
