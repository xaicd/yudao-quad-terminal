{
  "expo": {
    "name": "{{EXPO_APP_NAME}}",
    "slug": "{{EXPO_APP_SLUG}}",
    "version": "1.0.0",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "{{IOS_BUNDLE_ID}}"
    },
    "android": {
      "package": "{{ANDROID_PACKAGE}}"
    },
    "extra": {
      "projectName": "{{PROJECT_NAME}}",
      "platformTitle": "{{PLATFORM_TITLE}}",
      "basePath": "{{BASE_PATH}}",
      "apiBaseUrl": "http://127.0.0.1:{{GATEWAY_PORT}}{{BASE_PATH}}/app-api",
      "adminApiBaseUrl": "http://127.0.0.1:{{GATEWAY_PORT}}{{BASE_PATH}}/admin-api",
      "h5PortalUrl": "http://127.0.0.1:{{GATEWAY_PORT}}{{BASE_PATH}}/2c/",
      "openApiDocsUrl": "http://127.0.0.1:{{GATEWAY_PORT}}{{BASE_PATH}}/v3/api-docs"
    },
    "updates": {
      "url": "http://127.0.0.1:{{GATEWAY_PORT}}{{BASE_PATH}}/app-api/infra/ota/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
