{
  "name": "yudao-quad-terminal",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "all": "node scripts/run-all.cjs",
    "dev": "node scripts/run-all.cjs",
    "check:all": "node scripts/run-all.cjs --check",
    "deploy:caddy": "bash scripts/deploy-caddy.sh",
    "init:all": "bash scripts/lifecycle.sh . install",
    "test:all": "bash scripts/lifecycle.sh . test",
    "lifecycle:build": "bash scripts/lifecycle.sh . build",
    "start": "bash scripts/lifecycle.sh . start",
    "check:readiness": "node scripts/run-all.cjs --check",
    "dev:admin": "pnpm --filter yudao-ui-admin-vue3 dev",
    "dev:miniapp": "pnpm --filter shopro dev",
    "dev:app": "pnpm --filter @yudao-quad-terminal/app start",
    "backend:run": "cd apps/backend/yudao-server && mvn spring-boot:run -Dspring-boot.run.profiles=local",
    "project:reactor": "node scripts/project-reactor.mjs",
    "project:init": "node scripts/project-reactor.mjs --in-place",
    "project:hatch": "bash scripts/hatch.sh",
    "upstream:sync": "bash scripts/sync-upstream.sh",
    "upstream:status": "git submodule status",
    "gen:api-sdk": "bash packages/api-client/scripts/gen-api-sdk.sh",
    "gen:module": "node scripts/codegen-module.mjs",
    "ctx:snapshot": "node scripts/agent-context-compressor.mjs",
    "ctx:query": "node scripts/agent-context-compressor.mjs",
    "check:drift": "node scripts/check-contracts-drift.mjs",
    "trim:modules": "node scripts/trim-modules.mjs",
    "trim:check": "node scripts/trim-modules.mjs --check",
    "mcp:yudao": "node scripts/mcp/yudao-mcp-server.cjs",
    "openwiki:sync": "node scripts/sync-openwiki.mjs",
    "openwiki:check": "node scripts/sync-openwiki.mjs --check",
    "lite:up": "node scripts/lite-up.mjs",
    "lite:verify": "node scripts/lite-up.mjs --verify",
    "lite:clean": "rm -rf .commandcode/lite/pgdata .commandcode/lite/bin .commandcode/lite/redis-data",
    "gate:fast": "node scripts/gate-check.mjs --tier fast",
    "gate:full": "node scripts/gate-check.mjs --tier full",
    "build": "pnpm -r --filter './apps/*' --filter './packages/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "workflow:advance": "node scripts/workflow-engine.cjs --advance",
    "workflow:check": "node scripts/workflow-engine.cjs --check",
    "socratic:inquire": "node scripts/socratic-inquiry-engine.cjs",
    "socratic:check": "node scripts/socratic-inquiry-engine.cjs --check",
    "speckit": "node scripts/speckit.cjs",
    "speckit:init": "node scripts/speckit.cjs init",
    "speckit:constitution": "node scripts/speckit.cjs constitution",
    "speckit:new": "node scripts/speckit.cjs new",
    "speckit:specify": "node scripts/speckit.cjs new",
    "speckit:build": "node scripts/speckit.cjs build",
    "speckit:plan": "node scripts/speckit.cjs build",
    "speckit:tasks": "node scripts/speckit.cjs tasks",
    "speckit:task": "node scripts/speckit.cjs tasks",
    "speckit:check": "node scripts/speckit.cjs check",
    "speckit:list": "node scripts/speckit.cjs list",
    "spec:new": "node scripts/speckit.cjs new",
    "spec:build": "node scripts/speckit.cjs build",
    "spec:tasks": "node scripts/speckit.cjs tasks",
    "spec:check": "node scripts/speckit.cjs check",
    "task:verify": "node scripts/speckit.cjs tasks"
  },
  "packageManager": "pnpm@9.15.4"
}
